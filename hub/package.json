{
  "name": "qa-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Shared QA management with a Node.js API and Supabase",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui/smoke.mjs",
    "build": "node scripts/build.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-cloud.js",
    "deploy": "node scripts/deploy-vercel.js"
  },
  "engines": {
    "node": ">=20"
  }
}
